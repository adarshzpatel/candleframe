{
  "name": "candleframe",
  "version": "0.3.0",
  "description": "Framework-free WebGL2 financial charting engine and embeddable trading chart widget",
  "license": "MIT",
  "author": "adarshzpatel",
  "type": "module",
  "keywords": [
    "chart",
    "charting",
    "financial",
    "candlestick",
    "trading",
    "webgl",
    "webgl2",
    "order-book",
    "typescript"
  ],
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "files": [
    "dist/lib",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./core": {
      "types": "./dist/lib/core.d.ts",
      "import": "./dist/lib/core.js"
    },
    "./chart": {
      "types": "./dist/lib/chart-entry.d.ts",
      "import": "./dist/lib/chart-entry.js"
    },
    "./widget": {
      "types": "./dist/lib/widget-entry.d.ts",
      "import": "./dist/lib/widget-entry.js"
    },
    "./binance": {
      "types": "./dist/lib/binance.d.ts",
      "import": "./dist/lib/binance.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/lib/index.d.ts",
  "module": "./dist/lib/index.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "example:headless": "node --experimental-strip-types examples/headless.ts",
    "build": "npm run check && vite build && tsc -p tsconfig.lib.json && node scripts/copy-fonts.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm test && npm run build",
    "smoke": "node scripts/smoke.mjs",
    "mcp": "node --experimental-strip-types examples/mcp-server.ts",
    "bench": "node --experimental-strip-types scripts/bench.ts",
    "check:package": "node scripts/check-package.mjs",
    "palette": "node scripts/palette.mjs",
    "palette:check": "node scripts/palette.mjs --check"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "vite": "8.3.2"
  }
}
