{
  "name": "candleframe",
  "version": "0.3.0",
  "description": "Framework-free WebGL2 financial charting engine and embeddable trading chart widget",
  "license": "MIT",
  "author": "adarshzpatel",
  "homepage": "https://adarshzpatel.github.io/candleframe/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adarshzpatel/candleframe.git"
  },
  "bugs": {
    "url": "https://github.com/adarshzpatel/candleframe/issues"
  },
  "type": "module",
  "keywords": [
    "chart",
    "charting",
    "financial",
    "candlestick",
    "trading",
    "webgl",
    "webgl2",
    "hyperliquid",
    "typescript"
  ],
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "files": [
    "dist/lib",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./core": {
      "types": "./dist/lib/core.d.ts",
      "import": "./dist/lib/core.js"
    },
    "./chart": {
      "types": "./dist/lib/chart-entry.d.ts",
      "import": "./dist/lib/chart-entry.js"
    },
    "./widget": {
      "types": "./dist/lib/widget-entry.d.ts",
      "import": "./dist/lib/widget-entry.js"
    },
    "./trading": {
      "types": "./dist/lib/trading-entry.d.ts",
      "import": "./dist/lib/trading-entry.js"
    },
    "./binance": {
      "types": "./dist/lib/binance.d.ts",
      "import": "./dist/lib/binance.js"
    },
    "./hyperliquid": {
      "types": "./dist/lib/hyperliquid.d.ts",
      "import": "./dist/lib/hyperliquid.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/lib/index.d.ts",
  "module": "./dist/lib/index.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "example:headless": "node --experimental-strip-types examples/headless.ts",
    "build": "npm run check && vite build && npm run build:lib",
    "build:lib": "tsc -p tsconfig.lib.json && node scripts/copy-fonts.mjs",
    "prepare": "npm run build:lib",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm test && npm run build",
    "smoke": "node scripts/smoke.mjs",
    "mcp": "node --experimental-strip-types examples/mcp-server.ts",
    "bench": "node --experimental-strip-types scripts/bench.ts",
    "check:package": "node scripts/check-package.mjs",
    "regime:lag": "node --experimental-strip-types scripts/regime-lag.ts",
    "palette": "node scripts/palette.mjs",
    "palette:check": "node scripts/palette.mjs --check",
    "site:build": "npm run docs:commands && npm run build --prefix site && vite build --base /candleframe/demo/ --outDir site/dist/demo --emptyOutDir",
    "docs:commands": "node --experimental-strip-types scripts/generate-command-docs.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.9",
    "typescript": "~7.0.2",
    "vite": "8.3.2"
  }
}
