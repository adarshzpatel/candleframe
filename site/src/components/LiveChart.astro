---
/** The real widget on a simulated market, built from the library source, on a drafting sheet. */
---

<figure class="cf-sheet cf-live not-content">
  <div class="cf-live-chart" data-live-chart aria-label="Live CandleFrame chart on simulated data"></div>
  <figcaption class="cf-strip">
    <span>The real widget on simulated BTC/USD trades. Draw on it, add indicators, switch the chart type.</span>
    <a href="demo/">
      Full demo
      <svg class="cf-arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 11l6-6M6 5h5v5"></path></svg>
    </a>
  </figcaption>
</figure>

<script>
  import { createChartWidget } from '@candleframe/widget-entry.ts';
  import { createSimulatedFeed, sma } from '@candleframe/core.ts';
  import type { ChartTheme } from '@candleframe/themes.ts';

  // The chart in Caret's Neutral palette, so it sits on the page instead of in a box.
  // Hex values are Caret's OKLCH tokens; the order of indicator colors follows its chart-1…6.
  const typography = {
    uiFamily: '"Schibsted Grotesk Variable", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif',
    headingFamily: '"Schibsted Grotesk Variable", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif',
  };
  const dark: ChartTheme = {
    id: 'caret-dark',
    name: 'Caret dark',
    mode: 'dark',
    typography,
    palette: {
      background: '#161510',
      surface: '#1e1c17',
      raised: '#282721',
      border: '#333129',
      borderStrong: '#434138',
      text: '#bbc1c9',
      textStrong: '#edf0f5',
      textMuted: '#9ca0a7',
      textFaint: '#7d8086',
      accent: '#f0b142',
      accentText: '#201301',
      positive: '#3ab260',
      negative: '#f57569',
      grid: '#1c1b15',
      crosshair: '#9ca0a7',
      markerBackground: '#33322c',
      markerText: '#edf0f5',
      indicator: '#70a6f5',
      indicator2: '#d29933',
      indicator3: '#d774f5',
      indicator4: '#39b9bd',
      indicator5: '#f6787f',
      indicator6: '#5ebf34',
      drawing: '#f0b142',
      watermark: '#333129',
    },
  };
  const light: ChartTheme = {
    id: 'caret-light',
    name: 'Caret light',
    mode: 'light',
    typography,
    palette: {
      background: '#f5f4ef',
      surface: '#fdfcfa',
      raised: '#eeece8',
      border: '#dddbd5',
      borderStrong: '#cac8c2',
      text: '#42464d',
      textStrong: '#15181f',
      textMuted: '#5f6369',
      textFaint: '#777a80',
      accent: '#f5af26',
      accentText: '#201301',
      positive: '#007936',
      negative: '#b93e37',
      grid: '#edece7',
      crosshair: '#5f6369',
      markerBackground: '#e1e0db',
      markerText: '#15181f',
      indicator: '#458cf2',
      indicator2: '#b58329',
      indicator3: '#d054f3',
      indicator4: '#2d9b9e',
      indicator5: '#f55264',
      indicator6: '#4c9e28',
      drawing: '#af7c17',
      watermark: '#dddbd5',
    },
  };

  const host = document.querySelector<HTMLElement>('[data-live-chart]');
  if (host) {
    const feed = (symbol: 'BTC/USD' | 'ETH/USD' | 'SOL/USD', interval: '1m' | '5m' | '15m' | '1h') =>
      createSimulatedFeed({ symbol, interval, trades: true });
    const themeFor = () => (document.documentElement.dataset.theme === 'light' ? light : dark);
    const chart = createChartWidget(host, {
      feed: feed('BTC/USD', '1m'),
      theme: themeFor(),
      indicators: [sma(20)],
      markets: [
        {
          id: 'simulated',
          label: 'Simulation',
          symbols: ['BTC/USD', 'ETH/USD', 'SOL/USD'],
          intervals: ['1m', '5m', '15m', '1h'],
          createFeed: ({ symbol, interval }) => feed(symbol as 'BTC/USD', interval as '1m'),
        },
      ],
    });
    // Follow the site's light and dark switch.
    new MutationObserver(() => chart.setTheme(themeFor())).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });
  }
</script>
